# Facoltativo: solo indirizzo e porta per il server statico della webapp.
# I dati di gioco rimangono nel browser. Nessuna credenziale o database.
HOST=127.0.0.1
PORT=8787

# Facoltativo: campagne condivise. Solo URL e chiave PUBBLICA del nuovo progetto.
# Configurazione letta durante npm run build; dopo ogni modifica ricostruire dist/.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# URL pubblico della webapp, anche con sottocartella. Serve per gli inviti da desktop.
VITE_APP_URL=

# Schema Postgres esposto da Supabase. Predefinito: public.
VITE_SUPABASE_DB_SCHEMA=public
