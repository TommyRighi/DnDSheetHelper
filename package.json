{
  "name": "dnd-sheet-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test src/*.test.js",
    "test:e2e": "playwright test",
    "desktop:dev": "npm run build && node scripts/start-desktop.js",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:mac": "npm run build && electron-builder --mac dmg zip --arm64",
    "server": "node --env-file-if-exists=.env server/index.js",
    "test:server": "node --test server/*.test.js",
    "test:desktop": "node scripts/desktop-smoke.js",
    "test:offline": "node scripts/web-offline.js",
    "test:cloud": "node scripts/test-cloud.js"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.0"
  },
  "description": "Fable: personaggi, campagne e strumenti D&D per web e desktop",
  "author": "Fable",
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.16.0"
  }
}
